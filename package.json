{
  "name": "dskin",
  "description": "DSKIN - the cartoon pixel skin plugin for the DeepSeek Harness (DSH) web GUI: bright cartoon sky, pixel clouds, hard-shadow game panels, Press Start 2P chrome, a pixel whale and a pixel mouse mascot",
  "version": "0.1.0",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "skin",
    "theme",
    "pixel-art",
    "cartoon",
    "ui-skin",
    "deepseek"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run"
  },
  "license": "MIT",
  "peerDependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skin.json",
    "preview",
    "README.md",
    "README.en.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dancingmemory/dskin.git"
  }
}
