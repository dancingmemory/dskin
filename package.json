{
  "name": "dskin",
  "description": "DSKIN - cartoon pixel kittens for DeepSeek Harness (DSH): 1-4 random kittens spawn each session, they play together, you can pet them (hearts) and drag them around. Original UI untouched.",
  "version": "1.0.14",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "skin",
    "theme",
    "pixel-art",
    "cartoon",
    "ui-skin",
    "deepseek"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run"
  },
  "license": "MIT",
  "peerDependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skin.json",
    "preview",
    "assets",
    "README.md",
    "README.en.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dancingmemory/dskin.git"
  }
}